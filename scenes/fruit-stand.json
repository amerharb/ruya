{
	"id": "fruit-stand",
	"name": { "en": "fruit stand", "ar": "بسطة فواكه", "de": "der Obststand", "sv": "ett fruktstånd", "es": "el puesto de fruta", "uk": "фруктова ятка", "he": "דוכן פירות", "ja": "果物屋" },
	"things": {
		"pineapple": {
			"name": { "en": "pineapple", "ar": "أناناس", "de": "die Ananas", "sv": "en ananas", "es": "la piña", "uk": "ананас", "he": "אננס", "ja": "パイナップル" },
			"plural": { "en": "pineapples", "ar": "أناناس", "de": "die Ananas", "sv": "ananaser", "es": "las piñas", "uk": "ананаси", "he": "אננסים" },
			"dual": { "ar": "ثمرتا أناناس" },
			"note": "es piña, as in Spain, ananás in parts of South America; de die Ananas for many as for one, die Ananasse as right"
		},
		"watermelon": {
			"name": { "en": "watermelon", "ar": "بطيخة", "de": "die Wassermelone", "sv": "en vattenmelon", "es": "la sandía", "uk": "кавун", "he": "אבטיח", "ja": "すいか" },
			"plural": { "en": "watermelons", "ar": "بطيخ", "de": "die Wassermelonen", "sv": "vattenmeloner", "es": "las sandías", "uk": "кавуни", "he": "אבטיחים" },
			"dual": { "ar": "بطيختان" },
			"note": "ar بطيخ, as printed; Iraq says رقي and the Gulf جح; ja すいか, as it is usually written, スイカ as often"
		},
		"banana": {
			"name": { "en": "banana", "ar": "موزة", "de": "die Banane", "sv": "en banan", "es": "el plátano", "uk": "банан", "he": "בננה", "ja": "バナナ" },
			"plural": { "en": "bananas", "ar": "موز", "de": "die Bananen", "sv": "bananer", "es": "los plátanos", "uk": "банани", "he": "בננות" },
			"dual": { "ar": "موزتان" },
			"note": "es plátano, the word in Spain; banana in much of Latin America"
		},
		"coconut": {
			"name": { "en": "coconut", "ar": "جوزة هند", "de": "die Kokosnuss", "sv": "en kokosnöt", "es": "el coco", "uk": "кокос", "he": "אגוז קוקוס", "ja": "ココナッツ" },
			"plural": { "en": "coconuts", "ar": "جوز هند", "de": "die Kokosnüsse", "sv": "kokosnötter", "es": "los cocos", "uk": "кокоси", "he": "אגוזי קוקוס" },
			"dual": { "ar": "جوزتا هند" },
			"note": "he אגוז קוקוס, the nut, and קוקוס alone as often"
		},
		"melon": {
			"name": { "en": "melon", "ar": "شمامة", "de": "die Melone", "sv": "en melon", "es": "el melón", "uk": "диня", "he": "מלון", "ja": "メロン" },
			"plural": { "en": "melons", "ar": "شمام", "de": "die Melonen", "sv": "meloner", "es": "los melones", "uk": "дині", "he": "מלונים" },
			"dual": { "ar": "شمامتان" },
			"note": "a sweet melon with orange flesh, a cantaloupe as Americans call this one; ar شمام, and كنتالوب in Egypt"
		},
		"mango": {
			"name": { "en": "mango", "ar": "مانجو", "de": "die Mango", "sv": "en mango", "es": "el mango", "uk": "манго", "he": "מנגו", "ja": "マンゴー" },
			"plural": { "en": "mangoes", "ar": "مانجو", "de": "die Mangos", "sv": "mangor", "es": "los mangos", "uk": "манго", "he": "מנגואים" },
			"dual": { "ar": "ثمرتا مانجو" },
			"note": "en mangoes, mangos as right; uk манго is the same for many; he מנגואים, as dictionaries give it, though מנגו is often said for many"
		},
		"papaya": {
			"name": { "en": "papaya", "ar": "بابايا", "de": "die Papaya", "sv": "en papaya", "es": "la papaya", "uk": "папая", "he": "פפאיה", "ja": "パパイヤ" },
			"plural": { "en": "papayas", "ar": "بابايا", "de": "die Papayas", "sv": "papayor", "es": "las papayas", "uk": "папаї", "he": "פפאיות" },
			"dual": { "ar": "ثمرتا بابايا" },
			"note": "ja パパイヤ, the usual spelling, パパイア as right"
		},
		"pomegranate": {
			"name": { "en": "pomegranate", "ar": "رمانة", "de": "der Granatapfel", "sv": "ett granatäpple", "es": "la granada", "uk": "гранат", "he": "רימון", "ja": "ざくろ" },
			"plural": { "en": "pomegranates", "ar": "رمان", "de": "die Granatäpfel", "sv": "granatäpplen", "es": "las granadas", "uk": "гранати", "he": "רימונים" },
			"dual": { "ar": "رمانتان" },
			"note": "ja ざくろ, as it is usually written; 柘榴 is rare"
		},
		"apricot": {
			"name": { "en": "apricot", "ar": "مشمشة", "de": "die Aprikose", "sv": "en aprikos", "es": "el albaricoque", "uk": "абрикос", "he": "משמש", "ja": "あんず" },
			"plural": { "en": "apricots", "ar": "مشمش", "de": "die Aprikosen", "sv": "aprikoser", "es": "los albaricoques", "uk": "абрикоси", "he": "משמשים" },
			"dual": { "ar": "مشمشتان" },
			"note": "es albaricoque, as in Spain, damasco and chabacano in Latin America; de Aprikose, Marille in Austria; ja あんず, as it is usually written"
		},
		"apple": {
			"name": { "en": "apple", "ar": "تفاحة", "de": "der Apfel", "sv": "ett äpple", "es": "la manzana", "uk": "яблуко", "he": "תפוח", "ja": "りんご" },
			"plural": { "en": "apples", "ar": "تفاح", "de": "die Äpfel", "sv": "äpplen", "es": "las manzanas", "uk": "яблука", "he": "תפוחים" },
			"dual": { "ar": "تفاحتان" },
			"note": "he תפוח, short for תפוח עץ; ja りんご, as it is usually written, 林檎 being rare"
		},
		"lemon": {
			"name": { "en": "lemon", "ar": "ليمونة", "de": "die Zitrone", "sv": "en citron", "es": "el limón", "uk": "лимон", "he": "לימון", "ja": "レモン" },
			"plural": { "en": "lemons", "ar": "ليمون", "de": "die Zitronen", "sv": "citroner", "es": "los limones", "uk": "лимони", "he": "לימונים" },
			"dual": { "ar": "ليمونتان" }
		},
		"plum": {
			"name": { "en": "plum", "ar": "برقوقة", "de": "die Pflaume", "sv": "ett plommon", "es": "la ciruela", "uk": "слива", "he": "שזיף", "ja": "プラム" },
			"plural": { "en": "plums", "ar": "برقوق", "de": "die Pflaumen", "sv": "plommon", "es": "las ciruelas", "uk": "сливи", "he": "שזיפים" },
			"dual": { "ar": "برقوقتان" },
			"note": "ar برقوق, as in Egypt and print, where the Levant says خوخ; de Pflaume, Zwetschge in the south; ja プラム, the plum from abroad, すもも being Japan's own"
		},
		"orange": {
			"name": { "en": "orange", "ar": "برتقالة", "de": "die Orange", "sv": "en apelsin", "es": "la naranja", "uk": "апельсин", "he": "תפוז", "ja": "オレンジ" },
			"plural": { "en": "oranges", "ar": "برتقال", "de": "die Orangen", "sv": "apelsiner", "es": "las naranjas", "uk": "апельсини", "he": "תפוזים" },
			"dual": { "ar": "برتقالتان" },
			"note": "de Orange, Apfelsine as often in the north"
		},
		"pear": {
			"name": { "en": "pear", "ar": "كمثرى", "de": "die Birne", "sv": "ett päron", "es": "la pera", "uk": "груша", "he": "אגס", "ja": "洋梨" },
			"plural": { "en": "pears", "ar": "كمثرى", "de": "die Birnen", "sv": "päron", "es": "las peras", "uk": "груші", "he": "אגסים" },
			"dual": { "ar": "ثمرتا كمثرى" },
			"reading": { "ja": "洋梨[ようなし]" },
			"note": "ar كمثرى, as in Egypt and print, إجاص in the Levant and North Africa; ja 洋梨, the pear of this shape, as 梨 is the round Japanese one"
		},
		"tangerine": {
			"name": { "en": "tangerine", "ar": "يوسفي", "de": "die Mandarine", "sv": "en mandarin", "es": "la mandarina", "uk": "мандарин", "he": "קלמנטינה", "ja": "みかん" },
			"plural": { "en": "tangerines", "ar": "يوسفي", "de": "die Mandarinen", "sv": "mandariner", "es": "las mandarinas", "uk": "мандарини", "he": "קלמנטינות" },
			"dual": { "ar": "ثمرتا يوسفي" },
			"note": "American tangerine, a mandarin, as every other language here says; ar يوسفي, as in Egypt and the Gulf, مندلينا in the Levant; he קלמנטינה, the everyday word for any of them; ja みかん, Japan's own, as usually written"
		},
		"peach": {
			"name": { "en": "peach", "ar": "خوخة", "de": "der Pfirsich", "sv": "en persika", "es": "el melocotón", "uk": "персик", "he": "אפרסק", "ja": "桃" },
			"plural": { "en": "peaches", "ar": "خوخ", "de": "die Pfirsiche", "sv": "persikor", "es": "los melocotones", "uk": "персики", "he": "אפרסקים" },
			"dual": { "ar": "خوختان" },
			"reading": { "ja": "桃[もも]" },
			"note": "ar خوخ, the peach in Egypt, the Gulf and print; in the Levant it is the plum, and the peach دراق; es melocotón, as in Spain, durazno in Latin America"
		},
		"strawberry": {
			"name": { "en": "strawberry", "ar": "فراولة", "de": "die Erdbeere", "sv": "en jordgubbe", "es": "la fresa", "uk": "полуниця", "he": "תות", "ja": "いちご" },
			"plural": { "en": "strawberries", "ar": "فراولة", "de": "die Erdbeeren", "sv": "jordgubbar", "es": "las fresas", "uk": "полуниці", "he": "תותים" },
			"dual": { "ar": "فراولتان" },
			"note": "ar فراولة, one and many, فريز in the Levant; uk полуниця, the garden strawberry, as суниця is the wild one; he תות, as strawberries are called, תות שדה in full; ja いちご, as it is usually written"
		},
		"blueberry": {
			"name": { "en": "blueberry", "ar": "توت أزرق", "de": "die Heidelbeere", "sv": "ett blåbär", "es": "el arándano", "uk": "лохина", "he": "אוכמנית", "ja": "ブルーベリー" },
			"plural": { "en": "blueberries", "ar": "توت أزرق", "de": "die Heidelbeeren", "sv": "blåbär", "es": "los arándanos", "uk": "лохина", "he": "אוכמניות" },
			"dual": { "ar": "ثمرتا توت أزرق" },
			"note": "de Heidelbeere, Blaubeere as often; uk лохина, the berries together, as for many as for one, чорниця being the wild bilberry"
		},
		"grape": {
			"name": { "en": "grape", "ar": "عنبة", "de": "die Weintraube", "sv": "en vindruva", "es": "la uva", "uk": "виноград", "he": "ענב", "ja": "ぶどう" },
			"plural": { "en": "grapes", "ar": "عنب", "de": "die Weintrauben", "sv": "vindruvor", "es": "las uvas", "uk": "виноград", "he": "ענבים" },
			"dual": { "ar": "عنبتان" },
			"note": "in bunches; de Weintraube, one grape or the bunch; uk виноград, the fruit, one or many, a single grape being виноградина; ja ぶどう, as it is usually written"
		},
		"cherry": {
			"name": { "en": "cherry", "ar": "كرزة", "de": "die Kirsche", "sv": "ett körsbär", "es": "la cereza", "uk": "черешня", "he": "דובדבן", "ja": "さくらんぼ" },
			"plural": { "en": "cherries", "ar": "كرز", "de": "die Kirschen", "sv": "körsbär", "es": "las cerezas", "uk": "черешні", "he": "דובדבנים" },
			"dual": { "ar": "كرزتان" },
			"note": "sweet cherries: uk черешня, as вишня is the sour one; ja さくらんぼ, the fruit, as 桜 is the tree"
		},
		"kiwi": {
			"name": { "en": "kiwi", "ar": "كيوي", "de": "die Kiwi", "sv": "en kiwi", "es": "el kiwi", "uk": "ківі", "he": "קיווי", "ja": "キウイ" },
			"plural": { "en": "kiwis", "ar": "كيوي", "de": "die Kiwis", "sv": "kiwier", "es": "los kiwis", "uk": "ківі", "he": "קיווי" },
			"dual": { "ar": "ثمرتا كيوي" },
			"note": "the fruit, kiwifruit in full; uk ківі and he קיווי are the same for many"
		},
		"raspberry": {
			"name": { "en": "raspberry", "ar": "توت العليق", "de": "die Himbeere", "sv": "ett hallon", "es": "la frambuesa", "uk": "малина", "he": "פטל", "ja": "ラズベリー" },
			"plural": { "en": "raspberries", "ar": "توت العليق", "de": "die Himbeeren", "sv": "hallon", "es": "las frambuesas", "uk": "малина", "he": "פטל" },
			"dual": { "ar": "ثمرتا توت العليق" },
			"note": "ar توت العليق, فرامبواز in the Levant; uk малина and he פטל, the berries together, are the same for many"
		},
		"fig": {
			"name": { "en": "fig", "ar": "تينة", "de": "die Feige", "sv": "ett fikon", "es": "el higo", "uk": "інжир", "he": "תאנה", "ja": "いちじく" },
			"plural": { "en": "figs", "ar": "تين", "de": "die Feigen", "sv": "fikon", "es": "los higos", "uk": "інжири", "he": "תאנים" },
			"dual": { "ar": "تينتان" },
			"note": "uk інжир, смоква as right; ja いちじく, as it is usually written"
		},
		"date": {
			"name": { "en": "date", "ar": "تمرة", "de": "die Dattel", "sv": "en dadel", "es": "el dátil", "uk": "фінік", "he": "תמר", "ja": "デーツ" },
			"plural": { "en": "dates", "ar": "تمر", "de": "die Datteln", "sv": "dadlar", "es": "los dátiles", "uk": "фініки", "he": "תמרים" },
			"dual": { "ar": "تمرتان" },
			"note": "the fruit of the date palm; ja デーツ, as dates are sold, ナツメヤシ being the palm"
		}
	},
