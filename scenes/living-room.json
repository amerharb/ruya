{
	"id": "living-room",
	"name": { "en": "living room", "ar": "غرفة معيشة", "de": "das Wohnzimmer", "sv": "ett vardagsrum", "es": "el salón", "uk": "вітальня", "he": "סלון" },
	"things": {
		"window": {
			"name": { "en": "window", "ar": "نافذة", "de": "das Fenster", "sv": "ett fönster", "es": "la ventana", "uk": "вікно", "he": "חלון" }
		},
		"curtain": {
			"name": { "en": "curtain", "ar": "ستارة", "de": "der Vorhang", "sv": "en gardin", "es": "la cortina", "uk": "штора", "he": "וילון" },
			"note": "a heavy one that draws shut: de Vorhang and uk штора; a sheer one is Gardine and фіранка"
		},
		"picture": {
			"name": { "en": "picture", "ar": "لوحة", "de": "das Bild", "sv": "en tavla", "es": "el cuadro", "uk": "картина", "he": "תמונה" },
			"note": "a framed picture on the wall: tavla and cuadro are that word; a painting as such is Gemälde, målning, pintura"
		},
		"door": {
			"name": { "en": "door", "ar": "باب", "de": "die Tür", "sv": "en dörr", "es": "la puerta", "uk": "двері", "he": "דלת" },
			"note": "uk: двері has no singular"
		},
		"bookshelf": {
			"name": { "en": "bookshelf", "ar": "مكتبة", "de": "das Bücherregal", "sv": "en bokhylla", "es": "la estantería", "uk": "книжкова шафа", "he": "ספרייה" },
			"note": "ar مكتبة and he ספרייה are the bookcase at home as well as the library"
		},
		"lamp": {
			"name": { "en": "lamp", "ar": "مصباح", "de": "die Lampe", "sv": "en lampa", "es": "la lámpara", "uk": "лампа", "he": "מנורה" },
			"note": "a floor lamp, named with the general word; Stehlampe, golvlampa, lámpara de pie and торшер are this kind"
		},
		"couch": {
			"name": { "en": "couch", "ar": "أريكة", "de": "das Sofa", "sv": "en soffa", "es": "el sofá", "uk": "диван", "he": "ספה" },
			"note": "couch, the everyday American word; sofa is as right"
		},
		"pillow": {
			"name": { "en": "pillow", "ar": "وسادة", "de": "das Kissen", "sv": "en kudde", "es": "el cojín", "uk": "подушка", "he": "כרית" },
			"note": "American pillow, a throw pillow on the couch, where British English says cushion; es cojín, as almohada is the bed's"
		},
		"tv": {
			"name": { "en": "TV", "ar": "تلفاز", "de": "der Fernseher", "sv": "en tv", "es": "el televisor", "uk": "телевізор", "he": "טלוויזיה" },
			"note": "TV, as it is said, capitals and all; sv writes tv in small letters; es televisor is the set, televisión also what is on it"
		},
		"plant": {
			"name": { "en": "plant", "ar": "نبتة", "de": "die Pflanze", "sv": "en växt", "es": "la planta", "uk": "рослина", "he": "צמח" }
		},
		"rug": {
			"name": { "en": "rug", "ar": "سجادة", "de": "der Teppich", "sv": "en matta", "es": "la alfombra", "uk": "килим", "he": "שטיח" },
			"note": "a rug, not wall-to-wall carpet; the other languages have one word for both"
		},
		"armchair": {
			"name": { "en": "armchair", "ar": "كرسي بذراعين", "de": "der Sessel", "sv": "en fåtölj", "es": "el sillón", "uk": "крісло", "he": "כורסה" }
