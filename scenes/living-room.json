		},
		"couch": {
			"name": { "en": "couch", "ar": "أريكة", "de": "das Sofa", "sv": "en soffa", "es": "el sofá", "uk": "диван", "he": "ספה" },
			"note": "couch, the everyday American word; sofa is as right"
		},
		"pillow": {
			"name": { "en": "pillow", "ar": "وسادة", "de": "das Kissen", "sv": "en kudde", "es": "el cojín", "uk": "подушка", "he": "כרית" },
